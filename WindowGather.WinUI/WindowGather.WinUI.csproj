<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
    <DefineConstants Condition="'$(UiTestBuild)' == 'true'">$(DefineConstants);UI_PARITY_TEST</DefineConstants>
    <DefineConstants Condition="'$(UiTestBuild)' == 'true' and '$(UiPreviewBuild)' == 'true'">$(DefineConstants);UI_PREVIEW</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(ReleaseTag)' != ''">$(BaseIntermediateOutputPath)release-$(RuntimeIdentifier)-$(AssemblyVersion).manifest</ApplicationManifest>
    <AssemblyName>WindowGather.WinUI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowGather.Presentation\WindowGather.Presentation.csproj" />
    <ProjectReference Include="..\WindowGather.Infrastructure.Windows\WindowGather.Infrastructure.Windows.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(ReleaseTag)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryCommit</_Parameter1>
      <_Parameter2>$(RepositoryCommit)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseTag</_Parameter1>
      <_Parameter2>$(ReleaseTag)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="GenerateReleaseApplicationManifest" BeforeTargets="PrepareForBuild" Condition="'$(ReleaseTag)' != ''">
    <Error Condition="'$(ReleaseTag)' != 'v$(Version)' or '$(AssemblyVersion)' != '$(Version).0' or '$(FileVersion)' != '$(Version).0' or '$(InformationalVersion)' != '$(Version)' or '$(PackageVersion)' != '$(Version)' or '$(RepositoryCommit)' == '' or '$(IncludeSourceRevisionInInformationalVersion)' != 'false' or '$(ContinuousIntegrationBuild)' != 'true'"
           Text="Release tag, version properties and source commit must agree." />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\app.manifest" DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)" Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version" Value="$(AssemblyVersion)" />
  </Target>
</Project>
